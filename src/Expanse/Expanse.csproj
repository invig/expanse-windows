<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Expanse</AssemblyName>
    <RootNamespace>Expanse</RootNamespace>
    <ApplicationIcon>Expanse.ico</ApplicationIcon>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <!-- scripts/release.sh builds with ExpanseRelease=true: a release, which updates itself. -->
  <ItemGroup Condition="'$(ExpanseRelease)' == 'true'">
    <AssemblyMetadata Include="ExpanseRelease" Value="true" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Native\*.cs" Link="Native\%(Filename)%(Extension)" />
    <ProjectReference Include="..\Layout\Layout.csproj" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
  </ItemGroup>
</Project>
